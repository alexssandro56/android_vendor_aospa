<manifest>
  <include name="../platforms/sun.xml" />

  <!-- Device Dependencies: penguin-sm8735's consistent celerity set -->
  <project path="device/xiaomi/onyx" name="alexssandro56/android_device_xiaomi_onyx" remote="aospa" revision="celerity" />
  <project path="device/xiaomi/sepolicy" name="aospa-sm8735/android_device_xiaomi_sepolicy" remote="aospa" revision="calcite" />

  <!-- device/qcom/common: penguin's fork with the tuna perf target -->
  <remove-project name="AOSPA/android_device_qcom_common" />
  <project path="device/qcom/common" name="penguin-sm8735/device_qcom_common" remote="aospa" revision="celerity">
    <linkfile dest="vendor/qcom/build/tasks/generate_extra_images.mk" src="generate_extra_images.mk" />
  </project>

  <!-- Kernel: penguin's celerity kernel, device trees and modules together -->
  <project path="kernel/xiaomi/onyx" name="penguin-sm8735/android_kernel_xiaomi_onyx" remote="aospa" revision="celerity" />
  <project path="kernel/xiaomi/onyx-devicetrees" name="penguin-sm8735/android_kernel_xiaomi_onyx-devicetrees" remote="aospa" revision="celerity" />
  <project path="kernel/xiaomi/onyx-modules" name="penguin-sm8735/android_kernel_xiaomi_onyx-modules" remote="aospa" revision="celerity" />
  <project path="prebuilts/kernel-build-tools" name="kernel/prebuilts/build-tools" remote="aosp" revision="main" clone-depth="1" />
  <!-- Without kernel_definitions.mk, so CAF's kernel build doesn't run next to kernel.mk -->
  <project path="device/qcom/kernelscripts" name="AOSPA/android_kernel_build" remote="aospa" />
  <project path="lineage/scripts" name="LineageOS/scripts" remote="aospa" revision="main" clone-depth="1" />
  <project path="prebuilts/tools-lineage" name="LineageOS/android_prebuilts_tools-lineage" remote="aospa" revision="lineage-24.0" clone-depth="1" />
  <!-- fdtput and fdtoverlaymerge, which kernel.mk needs to merge the dtbs -->
  <project path="external/dtc" name="LineageOS/android_external_dtc" remote="aospa" revision="lineage-24.0" />

  <!-- Hardware -->
  <project path="hardware/xiaomi" name="penguin-sm8735/hardware_xiaomi" remote="aospa" revision="celerity" />

  <!-- Vendor -->
  <project path="vendor/qcom/opensource/core-utils-vendor" name="Project-PenguinOS/android_vendor_qcom_opensource_core-utils-vendor" remote="aospa" revision="celerity" />
  <project path="vendor/xiaomi/onyx" name="penguin-sm8735/android_vendor_xiaomi_onyx-aospa" remote="aospa" revision="celerity" />
  <!-- Leica MIUI camera: the one device/xiaomi/onyx inherits (onyx-leicacamera-vendor.mk).
       MiuiCamera.apk is stored in Git LFS, so run "git lfs pull" in this project after syncing. -->
  <project path="vendor/xiaomi/onyx-leicacamera" name="xiaomi-onyx-playground/android_vendor_xiaomi_onyx-leicacamera" remote="aospa" revision="lineage-24.0" />

  <!-- Packages -->
  <project path="packages/apps/LunarisDolby" name="unmoved21/packages_apps_LunarisDolby" remote="aospa" revision="16.0" />
  <!-- Pentas game sidebar -->
  <project path="packages/apps/Pentas" name="aospa-shadedark/android_packages_apps_Pentas" remote="aospa" revision="calcite" />
</manifest>
