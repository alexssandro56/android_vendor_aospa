// onyx builds its kernel from source. The header libraries the prebuilt kernel
// used to provide live in the kernel/xiaomi/onyx-modules namespace, which
// modules in the root namespace and in other device namespaces can't see.
// Expose them here, in the root namespace, under the names the HALs use.
//
// Most of the techpack header libraries are vendor only, but the prebuilt ones
// were vendor_available and some users (libudfps_extension.xiaomi, linked into
// surfaceflinger) build for system. Use the genrules behind them instead.
//
// include/ holds the UAPI headers the prebuilt kernel shipped that neither the
// GKI kernel nor the techpacks export (scsi/ufs, the msm_audio codec headers).

cc_library_headers {
    name: "qti_kernel_headers",
    vendor_available: true,
    recovery_available: true,
    export_include_dirs: ["include"],
    header_libs: [
        "generated_kernel_headers",
    ],
    export_header_lib_headers: [
        "generated_kernel_headers",
    ],
    generated_headers: [
        "//kernel/xiaomi/onyx-modules:qti_generate_audio_kernel_headers",
        "//kernel/xiaomi/onyx-modules:qti_generate_display_kernel_headers",
        "//kernel/xiaomi/onyx-modules:qti_generate_ipa_kernel_headers",
    ],
    export_generated_headers: [
        "//kernel/xiaomi/onyx-modules:qti_generate_audio_kernel_headers",
        "//kernel/xiaomi/onyx-modules:qti_generate_display_kernel_headers",
        "//kernel/xiaomi/onyx-modules:qti_generate_ipa_kernel_headers",
    ],
}

cc_library_headers {
    name: "audio_kernel_headers",
    vendor_available: true,
    recovery_available: true,
    export_include_dirs: ["include"],
    header_libs: [
        "generated_kernel_headers",
    ],
    export_header_lib_headers: [
        "generated_kernel_headers",
    ],
    generated_headers: [
        "//kernel/xiaomi/onyx-modules:qti_generate_audio_kernel_headers",
    ],
    export_generated_headers: [
        "//kernel/xiaomi/onyx-modules:qti_generate_audio_kernel_headers",
    ],
}

cc_library_headers {
    name: "libubwcp_headers",
    vendor_available: true,
    recovery_available: true,
    generated_headers: [
        "//kernel/xiaomi/onyx-modules:qti_generate_ubwcp_kernel_headers",
